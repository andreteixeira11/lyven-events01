# Variáveis necessárias para compilar a app Android (AAB) da LYVEN.
#
# IMPORTANTE:
# - Apenas as chaves EXPO_PUBLIC_* são usadas pela app (são públicas por definição
#   e vão incluídas no bundle — por isso nunca colocar segredos aqui).
# - As chaves privadas (SUPABASE_SERVICE_ROLE_KEY, SUPABASE_ACCESS_TOKEN,
#   RESEND_API_KEY, etc.) vivem apenas no backend (Edge Functions / Supabase)
#   e NÃO são necessárias para compilar a app para a Google Play.
# - Num novo ambiente, copie este ficheiro para expo/.env e preencha os valores
#   (ou copie diretamente o expo/.env existente do projeto Rork).

# Supabase (cliente público)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Rork (runtime/auth/db/functions)
EXPO_PUBLIC_PROJECT_ID=
EXPO_PUBLIC_RORK_API_BASE_URL=
EXPO_PUBLIC_RORK_APP_KEY=
EXPO_PUBLIC_RORK_AUTH_URL=
EXPO_PUBLIC_RORK_DB_ENDPOINT=
EXPO_PUBLIC_RORK_DB_NAMESPACE=
EXPO_PUBLIC_RORK_DB_TOKEN=
EXPO_PUBLIC_RORK_FUNCTIONS_URL=
EXPO_PUBLIC_RORK_TOOLKIT_SECRET_KEY=
EXPO_PUBLIC_TEAM_ID=
EXPO_PUBLIC_TOOLKIT_URL=
